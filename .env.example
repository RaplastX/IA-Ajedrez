# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# Obligatorio: secreto largo y aleatorio para firmar los JWT (p. ej. `openssl rand -hex 32`).
JWT_SECRET=

# Base de datos. Sin DATABASE_URL se usa PGlite (Postgres en WASM) en memoria o en PGLITE_DIR.
# DATABASE_URL=postgres://usuario:clave@host:5432/ajedrez
# PGLITE_DIR=./.data/pglite

CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost
PUBLIC_WEB_URL=http://localhost:5173

# Tutor: rules (sin coste), anthropic (Claude) o hf-tgi (modelo propio).
TUTOR_PROVIDER=rules
# ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-opus-5-5
# HF_TGI_URL=http://tgi:8080
# TUTOR_FREE=false

# Pagos (Stripe). Sin estas variables el checkout responde payments_disabled.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# Análisis en servidor con Stockfish nativo (la imagen Docker ya lo incluye).
# STOCKFISH_PATH=/usr/games/stockfish

# Observabilidad (requiere instalar @sentry/node).
# SENTRY_DSN=

# Web (Vite): URL absoluta de la API para la app móvil o despliegues en dominios separados.
# VITE_API_URL=https://api.example.com
# VITE_ANALYTICS_URL=
